# Railway auto-injects DATABASE_URL when you add a PostgreSQL plugin to the project.
DATABASE_URL=postgresql://user:pass@host:5432/railway
PGSSL=require
# Long random string — sign the session JWT with it.
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of THIS app (used for the Google OAuth redirect_uri).
APP_URL=https://erasezo.com
# Google OAuth (same client you set up; add APP_URL/api/auth/google/callback as an authorized redirect URI in Google Console).
GOOGLE_CLIENT_ID=642048681067-bfl3ekt6rphtd0sdghcejmojlj42g62r.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
DAILY_FREE=15
NODE_ENV=production
